# Copy to .env (the start script does this for you and sets a random Grafana password).

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: paste a Discord webhook URL here, then run the start script again.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Set by the start script: alertmanager.yml (no Discord) or alertmanager-discord.yml
ALERTMANAGER_CONFIG=alertmanager.yml

# How long Prometheus keeps metrics, and how busy the fake visitors are
PROMETHEUS_RETENTION=7d
REQUESTS_PER_SECOND=6

# Image versions (checked November 2026)
PROMETHEUS_VERSION=v3.16.0
ALERTMANAGER_VERSION=v0.35.0
NODE_EXPORTER_VERSION=v1.12.1
LOKI_VERSION=3.7.9
ALLOY_VERSION=v1.21.3
GRAFANA_VERSION=13.3.0
PYTHON_VERSION=3.13-alpine
